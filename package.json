{
  "name": "chesslens-ar",
  "version": "0.1.0",
  "description": "ChessLens AR - point your camera at a real chessboard and get live on-device analysis with Stockfish and an AR overlay. 100% offline, 100% free, GPL-3.0.",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "main": "electron/dist/main.mjs",
  "scripts": {
    "dev": "npm run copy:engine && vite",
    "copy:engine": "node scripts/copy-engine.mjs",
    "build": "npm run copy:engine && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "preview": "vite preview",
    "check:workflows": "node scripts/check-workflows.mjs",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win",
    "dist:linux": "npm run build && npm run build:electron && electron-builder --linux",
    "icons": "node scripts/gen-icons.mjs",
    "prepare:all": "npm run copy:engine && npm run icons && npm run icons:android",
    "icons:android": "node scripts/gen-android-art.mjs",
    "cap:sync": "cap sync"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@eslint/js": "^9.39.1",
    "chess.js": "^1.4.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.1",
    "jsdom": "^26.1.0",
    "stockfish": "^19.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "yaml": "^2.8.2"
  },
  "author": "ChessLens AR contributors"
}